{
  "name": "admin-portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "hr",
  "sourceRoot": "apps/admin-portal/src",
  "tags": ["type:app", "scope:remote"],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/admin-portal",
        "index": "apps/admin-portal/src/index.html",
        "main": "apps/admin-portal/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/admin-portal/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": ["apps/admin-portal/src/favicon.ico", "apps/admin-portal/src/assets"],
        "styles": ["apps/admin-portal/src/styles.scss"],
        "customWebpackConfig": {
          "path": "apps/admin-portal/webpack.config.ts"
        }
      },
      "configurations": {
        "production": {
          "customWebpackConfig": {
            "path": "apps/admin-portal/webpack.config.prod.ts"
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "admin-portal:build:development",
        "port": 4201
      },
      "configurations": {
        "development": {
          "buildTarget": "admin-portal:build:development"
        },
        "production": {
          "buildTarget": "admin-portal:build:production"
        }
      }
    }
  }
}
