root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{java,xml,yml,yaml,json,md}]
indent_size = 2

[*.{ts,tsx,html,scss,css}]
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 140

[Makefile]
indent_style = tab
